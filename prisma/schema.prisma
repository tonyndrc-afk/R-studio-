generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ModuleType {
  PACKSHOT
  AMBIANCE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AssetStatus {
  DRAFT
  VALIDATED
}

model Product {
  id         String   @id @default(cuid())
  title      String
  sku        String   @unique
  sourceUrl  String?
  attributes Json?
  dimensions Json?
  images     Json?
  createdAt  DateTime @default(now())
  assets     Asset[]
  jobs       Job[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  assets    Asset[]
}

model Asset {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  folderId   String?
  folder     Folder?     @relation(fields: [folderId], references: [id])
  module     ModuleType
  status     AssetStatus @default(DRAFT)
  filePath   String
  prompt     String
  sourceUrl  String?
  metadata   Json?
  compliance Json?
  createdAt  DateTime    @default(now())
}

model Job {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  module    ModuleType
  status    JobStatus @default(PENDING)
  input     Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
